{
  "name": "share-music-assistant-io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Landing page for Music Assistant share links",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check \"**/*.{js,ts,vue,html,css}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,html,css}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "@vueuse/core": "^14.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^9.24.0",
    "eslint-plugin-vue": "^10.2.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.9"
  }
}
